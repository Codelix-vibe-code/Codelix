{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelix.dev/schemas/progress-v1.schema.json",
  "title": "Codelix project progress v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "updated_at", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "dependencies", "acceptance_criteria", "attempts", "files_modified", "verifications", "last_result"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["todo", "in_progress", "blocked", "needs_review", "done", "interrupted", "cancelled"]},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "files_modified": {"type": "array", "items": {"type": "string"}},
        "verifications": {"type": "array", "items": {"type": "object"}},
        "last_result": {"type": ["string", "null"]}
      }
    }
  }
}
