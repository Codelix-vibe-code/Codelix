{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelix.dev/schemas/coder-v1.schema.json",
  "title": "Vybelix Coder output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "summary", "files", "notes", "verification_hints"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "task_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what_changed", "why", "how_to_verify"],
      "properties": {
        "what_changed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "why": {"type": "string", "minLength": 1},
        "how_to_verify": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "files": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/file"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "verification_hints": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\)"},
        "operation": {"const": "write"},
        "content": {"type": "string"}
      }
    }
  }
}
